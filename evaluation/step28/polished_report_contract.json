      "evidence_end_seconds",
      "representative_timestamp_seconds",
      "representative_frame_index",
      "evidence_summary",
      "recommended_action"
    ],
    "evidence_image_source": "existing keyframe short-lived URL",
    "video_link_source": "original walkthrough short-lived URL"
  },
  "guardrails": {
    "uses_step27_safe_descriptions": true,
    "preserves_numeric_confidence": true,
