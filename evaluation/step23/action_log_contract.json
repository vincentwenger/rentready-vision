{
  "step": 23,
  "schema_version": "rentready-agent-action-log/1.0",
  "artifact_suffix": "step23-agent-action-log.json",
  "required_action_fields": [
    "candidate_id",
    "action",
    "reason",
    "input_timestamp",
    "frames_returned",
    "confidence_before",
    "confidence_after"
  ],
  "ordered_actions": [
    "observe_candidate",
    "inspect_interval or verify_evidence when investigation is required",
    "crop_region when temporal evidence is insufficient",
    "final_decision"
  ],
  "persistence": {
    "embedded_in_step22_trace": true,
    "dedicated_s3_json": true,
    "read_endpoint": "GET /inspections/{inspection_id}/agent/actions",
    "deterministic_event_id": true
  },
  "demo": {
    "heading": "Agent Investigation",
    "shows_observation": true,
    "shows_reason_for_each_action": true,
    "shows_opencv_frame_count": true,
    "shows_confidence_transition": true,
    "shows_final_result": true
  },
  "local_status": "PASS",
  "live_aws_status": "PASS"
}
