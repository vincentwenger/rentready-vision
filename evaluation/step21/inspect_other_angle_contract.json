    "bounded_controls": {
      "search_seconds_before": {"default": 4.0, "minimum": 0.0, "maximum": 30.0},
      "search_seconds_after": {"default": 4.0, "minimum": 0.0, "maximum": 30.0},
      "sample_every_seconds": {"default": 0.5, "minimum": 0.1, "maximum": 5.0},
      "max_results": {"default": 3, "minimum": 2, "maximum": 5},
      "min_viewpoint_change": {"default": 0.06, "minimum": 0.0, "maximum": 1.0}
