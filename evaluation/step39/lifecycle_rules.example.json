            }
          ]
        }
      },
      "Expiration": {
        "Days": 30
      },
      "NoncurrentVersionExpiration": {
        "NoncurrentDays": 30
      }
    },
    {
      "ID": "rentready-step39-legacy-multipart",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "inspections/"
      },
