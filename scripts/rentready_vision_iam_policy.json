{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectionObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging",
        "s3:GetObjectVersionTagging",
        "s3:PutObjectVersionTagging"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_EXACT_BUCKET/inspections/*",
        "arn:aws:s3:::REPLACE_WITH_EXACT_BUCKET/rentready/inspections/*"
      ]
    },
    {
      "Sid": "InspectionState",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:us-west-2:123456789012:table/REPLACE_WITH_EXACT_TABLE"
    },
    {
      "Sid": "EnqueueJobs",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": "arn:aws:sqs:us-west-2:123456789012:REPLACE_WITH_EXACT_QUEUE"
    }
  ]
}
