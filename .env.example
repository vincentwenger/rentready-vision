APP_ENV=dev
# Set this in deployed API containers that do not include .git metadata.
GIT_COMMIT=
AWS_REGION=us-west-2
S3_BUCKET=rentready-vision-dev-REPLACE_ME
DDB_TABLE=rentready-vision-dev

# Leave blank for local developer fallback. For the judge/demo, set this to the
# Terraform processing_queue_url so the Graviton4 + COOL worker is mandatory.
PROCESSING_QUEUE_URL=
PROCESSING_DLQ_URL=
QUEUE_VISIBILITY_TIMEOUT_SECONDS=1800
QUEUE_MAX_RECEIVE_COUNT=5
QUEUE_RETRY_BASE_SECONDS=60
PROCESSING_LEASE_SECONDS=2100
COOL_REQUIRED=false
COOL_EXPECTED_CV2_PREFIX=/opt/cool
COOL_LOG_GROUP=/rentready-vision/cool-worker
CLOUDWATCH_METRICS_NAMESPACE=RentReadyVision/Processing

# Step 16 visible-issue detector. Nova 2 Lite is multimodal; the US geo
# inference profile can be invoked from us-west-2.
ISSUE_DETECTION_ENABLED=true
ISSUE_DETECTION_MODEL_ID=us.amazon.nova-2-lite-v1:0
ISSUE_DETECTION_CONFIDENCE_THRESHOLD=0.65
ISSUE_DETECTION_BATCH_SIZE=8
ISSUE_DETECTION_MAX_KEYFRAMES=120
ISSUE_DETECTION_MAX_TOKENS=2500

PRESIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=1073741824
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

PROCESSING_SAMPLE_EVERY_SECONDS=1.0
PROCESSING_SCENE_THRESHOLD=0.75
PROCESSING_SCENE_FEATURE_THRESHOLD=0.22
PROCESSING_SCENE_COMBINED_THRESHOLD=0.55
PROCESSING_SCENE_MIN_DURATION_SECONDS=4.0
PROCESSING_SCENE_MAX_DURATION_SECONDS=30.0
PROCESSING_SCENE_MOTION_SUPPORT_PERCENT_PER_SECOND=12.0
PROCESSING_SCENE_ANALYSIS_WIDTH=480
PROCESSING_SCENE_MAX_ORB_FEATURES=600
PROCESSING_DEDUPE_THRESHOLD=0.94
PROCESSING_DEDUPE_FEATURE_THRESHOLD=0.55
PROCESSING_MIN_SHARPNESS=45.0
PROCESSING_BLUR_TILE_GRID_SIZE=3
PROCESSING_MIN_SHARP_TILES_PERCENT=50.0
PROCESSING_MOTION_BLUR_MIN_MOTION_PERCENT_PER_SECOND=8.0
PROCESSING_MOTION_BLUR_SHARPNESS_MULTIPLIER=1.5
PROCESSING_MIN_BRIGHTNESS=25.0
PROCESSING_MAX_BRIGHTNESS=235.0
PROCESSING_DARK_PIXEL_VALUE=16
PROCESSING_BRIGHT_PIXEL_VALUE=240
PROCESSING_MAX_DARK_PIXELS_PERCENT=60.0
PROCESSING_MAX_BRIGHT_PIXELS_PERCENT=35.0
PROCESSING_MAX_MOTION_PERCENT_PER_SECOND=30.0
PROCESSING_MIN_MOTION_FEATURES=12
PROCESSING_QUALITY_ANALYSIS_WIDTH=720
PROCESSING_MOTION_ANALYSIS_WIDTH=480
PROCESSING_MOTION_INTERVAL_SECONDS=0.1
PROCESSING_MOTION_WINDOW_SIZE=3
PROCESSING_MIN_MOTION_INLIERS=12
PROCESSING_MIN_MOTION_INLIER_RATIO=0.25
PROCESSING_MIN_KEYFRAMES_PER_SCENE=3
PROCESSING_MAX_KEYFRAMES_PER_SCENE=8
PROCESSING_MIN_KEYFRAME_SEPARATION_SECONDS=4.0
PROCESSING_KEYFRAME_MARGINAL_SCORE_THRESHOLD=0.62
PROCESSING_KEYFRAME_WEIGHT_SHARPNESS=0.30
PROCESSING_KEYFRAME_WEIGHT_BRIGHTNESS=0.15
PROCESSING_KEYFRAME_WEIGHT_STABILITY=0.20
PROCESSING_KEYFRAME_WEIGHT_DISTINCTIVENESS=0.25
PROCESSING_KEYFRAME_WEIGHT_TEMPORAL_DISTANCE=0.10
PROCESSING_MAX_OUTPUT_KEYFRAMES=120
PROCESSING_MIN_OUTPUT_KEYFRAMES=3
PROCESSING_FALLBACK_SPACING_SECONDS=2.0
# Step 18 Agentic Vision
AGENTIC_REINSPECT_MIN_CONFIDENCE=0.45
AGENTIC_REINSPECT_MAX_CONFIDENCE=0.80
AGENTIC_DEFAULT_SECONDS_BEFORE=2
AGENTIC_DEFAULT_SECONDS_AFTER=3
AGENTIC_DEFAULT_SAMPLE_FPS=6
AGENTIC_ACCEPT_THRESHOLD=0.80
AGENTIC_DISMISS_THRESHOLD=0.45

